[
	{
		"id": "view",
		"children": [
			{
				"caption": "Algorithm Competition Assistant",
				"children": [
					{
						"caption": "Run",
						"command": "cph_view_tester",
						"args": {
							"action": "make_opd"
						}
					},
					{
						"caption": "Run with clean tests",
						"command": "cph_view_tester",
						"args": {
							"action": "make_opd",
							"clr_tests": true
						}
					},
					{
						"caption": "Toggle hide phantoms",
						"command": "cph_test_manager",
						"args": {
							"action": "toggle_hide_phantoms"
						}
					},
					{
						"caption": "Listen to Competitive Companion (new file per problem)",
						"command": "cph_companion_listener",
						"args": {"target": "new_file"}
					},
					{
						"caption": "Listen to Competitive Companion (fill the current file)",
						"command": "cph_companion_listener",
						"args": {"target": "current_file"}
					},
					{
						"caption": "Stop Competitive Companion listener",
						"command": "cph_companion_stop_listener"
					},
					{
						"caption": "Import tests from file...",
						"command": "cph_import_tests"
					},
					{
						"caption": "Pick and import test file",
						"command": "cph_pick_import_file"
					},
					{
						"caption": "Start stress test",
						"command": "cph_start_stress_test"
					},
					{
						"caption": "Stop stress test",
						"command": "cph_stop_stress_test"
					},
					{
						"caption": "Switch language",
						"command": "cph_language_toggle_language"
					},
					{
						"caption": "-"
					},
					{
						"caption": "Run all tests (keep going after failures)",
						"command": "cph_run_all_tests"
					},
					{
						"caption": "Re-run failed tests only",
						"command": "cph_run_failed_tests"
					},
					{
						"caption": "Run (force recompile)",
						"command": "cph_run_force_recompile"
					},
					{
						"caption": "-"
					},
					{
						"caption": "Add test from clipboard",
						"command": "cph_add_test_from_clipboard"
					},
					{
						"caption": "Copy test input",
						"command": "cph_copy_test_input"
					},
					{
						"caption": "Copy expected output",
						"command": "cph_copy_test_expected"
					},
					{
						"caption": "Copy actual output",
						"command": "cph_copy_test_actual"
					},
					{
						"caption": "Export tests as .in/.out files",
						"command": "cph_export_tests"
					},
					{
						"caption": "-"
					},
					{
						"caption": "Verdict rules (float tolerance, PE as AC, stop on first failure)...",
						"command": "cph_verdict_mode"
					},
					{
						"caption": "Stress test options (where std/gen come from, rounds)...",
						"command": "cph_stress_options"
					},
					{
						"caption": "Competitive Companion options (target mode, click log)...",
						"command": "cph_companion_options"
					},
					{
						"caption": "Check environment (doctor)",
						"command": "cph_doctor"
					},
					{
						"caption": "Test actions (run / detail / edit a test)",
						"command": "cph_test_menu"
					}
				]
			}
		]
	},
	{
		"caption": "Preferences",
		"mnemonic": "P",
		"id": "preferences",
		"children": [
			{
				"caption": "Package Settings",
				"mnemonic": "P",
				"id": "package-settings",
				"children": [
					{
						"caption": "Algorithm Competition Assistant",
						"children": [
							{
								"caption": "Settings",
								"command": "cph_open_package_file",
								"args": {
									"file": "Algorithm Competition Assistant.sublime-settings",
									"edit_base": true,
									"default": "{\n\t$0\n}\n"
								}
							},
							{
								"caption": "README / 使用说明",
								"command": "cph_open_package_file",
								"args": {
									"file": "README.md"
								}
							},
							{
								"caption": "Key Bindings",
								"command": "cph_open_package_file",
								"args": {
									"file": "Default ($platform).sublime-keymap",
									"edit_base": true,
									"default": "[\n\t// Algorithm Competition Assistant ships its bindings inside the package keymap,\n\t// gated behind \"enable_keybindings\". Put your own copy here to override them,\n\t// e.g.\n\t// { \"keys\": [\"ctrl+alt+b\"], \"command\": \"cph_view_tester\", \"args\": {\"action\": \"make_opd\"} },\n\t// { \"keys\": [\"ctrl+alt+s\"], \"command\": \"cph_start_stress_test\" },\n\t$0\n]\n"
								}
							},
							{
								"caption": "Syntax-Specific Settings (TestSyntax)",
								"command": "cph_open_package_file",
								"args": {
									"file": "TestSyntax.sublime-settings",
									"edit_base": true,
									"default": "{\n\t$0\n}\n"
								}
							}
						]
					}
				]
			}
		]
	}
]
