[
	{
		"caption": "Algorithm Competition Assistant: Run",
		"command": "cph_view_tester",
		"args": {"action": "make_opd"}
	},
	{
		"caption": "Algorithm Competition Assistant: Import tests from file...",
		"command": "cph_import_tests"
	},
	{
		"caption": "Algorithm Competition Assistant: Pick and import test file",
		"command": "cph_pick_import_file"
	},
	{
		"caption": "Algorithm Competition Assistant: Listen to CC, one new file per problem",
		"command": "cph_companion_listener",
		"args": {"target": "new_file"}
	},
	{
		"caption": "Algorithm Competition Assistant: Listen to CC, fill the current file",
		"command": "cph_companion_listener",
		"args": {"target": "current_file"}
	},
	{
		"caption": "Algorithm Competition Assistant: Start stress test",
		"command": "cph_start_stress_test"
	},
	{
		"caption": "Algorithm Competition Assistant: Stop stress test",
		"command": "cph_stop_stress_test"
	}
]
