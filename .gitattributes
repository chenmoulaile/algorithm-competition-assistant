# Normalize every line ending to LF in the repo, so a Windows clone of this
# package does not carry CRLF into files a Sublime Text Python 3.3 host reads.
* text=auto eol=lf

# Imports are binary blobs, not text that could be re-encoded.
*.png binary
*.jpg binary
*.ico binary
*.mp4 binary
*.pdf binary

# Not part of the shipped package: Package Control's export drops them, but
# they stay here so a local diff against an old build is still possible.
*.bak-* export-ignore
.workbuddy/ export-ignore
.workbuddy-ai export-ignore
.zcode/ export-ignore
_fake_packages/ export-ignore
.github/ export-ignore
tests/ export-ignore
ScreenShots/ export-ignore
PC_SUBMISSION_NOTES.md export-ignore
RELEASE_NOTES_CN.md export-ignore
.gitignore export-ignore
.gitattributes export-ignore
